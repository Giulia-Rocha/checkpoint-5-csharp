<Window x:Class="CadastroProdutos.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Produtos" Height="650" Width="1000"
        MinHeight="560" MinWidth="850" WindowStartupLocation="CenterScreen">
    <DockPanel Background="#F4F6F8">
        <Menu DockPanel.Dock="Top" Background="#183153" Foreground="White" FontSize="14">
            <MenuItem Header="Inserir produto" Click="Inserir_Click" />
            <MenuItem Header="Listar produtos" Click="Listar_Click" />
            <MenuItem Header="Buscar produto por ID" Click="Buscar_Click" />
            <MenuItem Header="Atualizar produto" Click="Atualizar_Click" />
            <MenuItem Header="Excluir produto" Click="Excluir_Click" />
            <Separator />
            <MenuItem Header="Sair" Click="Sair_Click" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#E5EAF0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Pronto." />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="Dados do produto" FontSize="22" FontWeight="SemiBold" Foreground="#183153" Margin="0,0,0,14" />

                    <TextBlock Text="ID" FontWeight="SemiBold" />
                    <TextBox x:Name="IdTextBox" ToolTip="Informe o ID para buscar, atualizar ou excluir" />

                    <TextBlock Text="Nome" FontWeight="SemiBold" />
                    <TextBox x:Name="NomeTextBox" MaxLength="120" />

                    <TextBlock Text="Preço" FontWeight="SemiBold" />
                    <TextBox x:Name="PrecoTextBox" ToolTip="Exemplo: 19,90" />

                    <TextBlock Text="Estoque" FontWeight="SemiBold" />
                    <TextBox x:Name="EstoqueTextBox" />

                    <TextBlock Text="Categoria" FontWeight="SemiBold" />
                    <TextBox x:Name="CategoriaTextBox" MaxLength="80" />

                    <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="Inserir" Click="Inserir_Click" Background="#2D7D46" Foreground="White" />
                        <Button Content="Atualizar" Click="Atualizar_Click" Background="#246B9E" Foreground="White" />
                        <Button Content="Excluir" Click="Excluir_Click" Background="#B23A48" Foreground="White" />
                        <Button Content="Limpar" Click="Limpar_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Produtos cadastrados" FontSize="22" FontWeight="SemiBold" Foreground="#183153" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Buscar ID" Click="Buscar_Click" />
                        <Button Grid.Column="2" Content="Atualizar lista" Click="Listar_Click" />
                    </Grid>

                    <DataGrid x:Name="ProdutosDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="ProdutosDataGrid_SelectionChanged"
                              AlternatingRowBackground="#F3F6FA"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                            <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat=C}" Width="110" />
                            <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="90" />
                            <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
